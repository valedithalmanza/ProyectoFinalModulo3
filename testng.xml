<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="OrangeHRM Suite" verbose="1" >
    <listeners>
        <listener class-name="com.orangehrm.core.reporting.TestListener" />
    </listeners>
    <test name="OrangeHRM chrome" >
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.orangehrm.tests" />
        </packages>
    </test>
    <test name="OrangeHRM firefox" >
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="com.orangehrm.tests" />
        </packages>
    </test>
</suite>
